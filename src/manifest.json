{
  "manifestVersion": 5,
  "id": "local.artboard.renamer",
  "name": "Artboard Renamer",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "renamerPanel",
      "label": { "default": "Artboard Renamer" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 340, "height": 620 }
    }
  ]
}
